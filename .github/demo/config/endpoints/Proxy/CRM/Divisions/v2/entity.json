    "Methods": ["GET", "POST", "PUT", "DELETE"],
    "Documentation": {
        "TagDescription": "Manage the divisions and branch locations of your organisation. Version 2 returns a `count` and `value` collection.",
        "MethodDescriptions": {
            "GET": "List divisions",
            "POST": "Create a division",
            "PUT": "Update a division",
            "DELETE": "Delete a division"
        },
        "MethodDocumentation": {
            "GET": "Returns a `count` and a `value` array of divisions.",
            "POST": "Creates a division. Returns `201` with the division.",
            "PUT": "Replaces the division with the request body. Returns the division.",
            "DELETE": "Deletes the division. Returns `204`."
        },
