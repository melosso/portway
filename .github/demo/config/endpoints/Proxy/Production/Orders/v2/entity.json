{
    "Url": "http://nginx/api/v2/production",
    "Methods": ["GET", "POST", "PUT", "DELETE"],
    "Documentation": {
        "TagDescription": "Monitor and manage production orders. Version 2 returns `orderNumber` and status codes such as `in_progress`.",
        "MethodDescriptions": {
            "GET": "List production orders",
            "POST": "Create a new production order",
            "PUT": "Update production order status",
            "DELETE": "Cancel/Delete production order"
        },
        "MethodDocumentation": {
            "GET": "Returns every production order. Status values: `planned`, `in_progress`, `on_hold`, `completed`, `cancelled`.",
            "POST": "Creates a production order. Returns `201` with the order.",
            "PUT": "Replaces the production order with the request body. Returns the order.",
            "DELETE": "Cancels the production order. Returns `204`."
        },
        "Examples": {
